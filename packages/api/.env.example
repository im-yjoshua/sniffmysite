# API env template — copy to `.env` (gitignored) and fill in.
# NEVER commit real keys. The service-role key stays server-side ONLY;
# it must never appear in the frontend bundle or any VITE_* variable.

PORT=4000

# Comma-separated CORS allowlist (§1.5): production domains + local dev.
# Tighten to exactly the two production domains before launch.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase project (Singapore). Service-role key bypasses RLS — the API uses
# it to insert pending listings (anon has no INSERT grant on burn.companies).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret for bot checks on public write endpoints.
# Enforced on POST /api/vapor/scan (Task 10); warn-and-pass when unset (dev).
# TODO (deploy-time): set this on Render before launch; the scan form renders
# the widget when VITE_TURNSTILE_SITE_KEY is set in apps/vapor.
# Test secret that always passes (dev only): 1x0000000000000000000000000000000AA
# Test site key (pairs with it): 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# Canonical public site URL (no trailing slash) — used on report card PNGs
# and in link-preview metadata. The Render API URL isn't assigned until the
# service is created; set this at deploy time.
PUBLIC_SITE_URL=https://burn-rate.lol

# Public API origin (no trailing slash) — where magic-link emails point.
# Falls back to PUBLIC_SITE_URL when unset (works if the API is ever
# same-origin or proxied). Set to the Render origin at deploy time, e.g.:
# PUBLIC_API_URL=https://burnrate-api.onrender.com
PUBLIC_API_URL=

# Resend (magic-link emails for the founder claim flow, Task 7).
# UNSET = dev mode: no email is sent; the magic link is logged to the server
# console with a loud warning and the endpoint still returns "check your inbox".
# Production needs BOTH: the key, and a VERIFIED sender domain for
# RESEND_FROM_EMAIL (Resend rejects unverified domains).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@burn-rate.lol

# Server secret for the DNS challenge HMAC (founder claim flow, Task 7).
# Unset = dev mode: an ephemeral secret is generated per process restart
# (claim flows work locally, but DNS challenges won't survive a restart).
# Set a long random value before launch.
CLAIM_DNS_SECRET=

# Lemon Squeezy billing (Task 9) — TEST MODE ONLY until the seller
# application is approved. The server hard-refuses checkout creation
# unless LEMONSQUEEZY_TEST_MODE=true (see PROGRESS.md "Task 9" for the
# step-by-step test-mode setup). NEVER commit real keys.
LEMONSQUEEZY_TEST_MODE=true
# Settings → API in the Lemon Squeezy dashboard (test-mode key while testing).
LEMONSQUEEZY_API_KEY=
# Store ID (dashboard URL or GET /v1/stores).
LEMONSQUEEZY_STORE_ID=
# Settings → Webhooks → your endpoint → signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs for the two Task 9 products (create them in the LS dashboard
# in test mode: "Priority Re-scan" $5, "Certified Real Audit" $29).
LEMONSQUEEZY_RESCAN_VARIANT_ID=
LEMONSQUEEZY_AUDIT_VARIANT_ID=
# Variant IDs for the three Task 8 (BurnRate) products — create in the LS
# dashboard in test mode: "Verified Burner" $9, "Custom report card theme" $4,
# "Weekly spotlight bid" (variable price, $5 minimum).
LEMONSQUEEZY_BADGE_VARIANT_ID=
LEMONSQUEEZY_THEME_VARIANT_ID=
LEMONSQUEEZY_SPOTLIGHT_VARIANT_ID=

# Variant IDs for the two sponsor-banner products (SniffMySite homepage).
# Create in the LS dashboard in test mode. PRICES ARE PLACEHOLDER — Joshua
# sets final pricing before live. Banner webhooks create a sponsor record
# as pending_approval; a human approves it before it goes live.
LEMONSQUEEZY_BANNER7_VARIANT_ID=
LEMONSQUEEZY_BANNER30_VARIANT_ID=

# Admin token for the /api/vapor/admin/sponsors approval routes (and the
# /admin/sponsors page). NEVER commit the real value — set it on the
# server (Render env) only. Missing → all admin routes 503.
ADMIN_TOKEN=
