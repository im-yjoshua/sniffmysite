# Copy to .env and fill in. NEVER commit .env.

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shared Express API base URL (used when calling /api/* directly)
VITE_API_URL=http://localhost:4000

# Cloudflare Turnstile site key for the scan bot check (Task 10).
# UNSET = no widget in dev; the API skips the check when its secret is unset.
# Test key that always passes (dev only): 1x00000000000000000000AA
# Get a real key: Cloudflare dashboard → Turnstile → Add site.
VITE_TURNSTILE_SITE_KEY=
