# Frontend env template — copy to `.env` (gitignored) and fill in.
# These are PUBLIC values baked into the bundle at build time; never put
# secrets in VITE_* variables.

# Render API origin. In local dev this stays EMPTY — same-origin /api calls
# ride the Vite dev proxy (vite.config.ts → localhost:4000). The Cloudflare
# Pages production build MUST set this, e.g.:
# VITE_PUBLIC_API_BASE_URL=https://burnrate-api.onrender.com
VITE_PUBLIC_API_BASE_URL=

# Canonical site URL (no trailing slash). Used in share text. Matches
# src/config.ts SITE_URL; live once burn-rate.lol is purchased.
VITE_SITE_URL=https://burn-rate.lol
